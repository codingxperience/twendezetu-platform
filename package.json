{
  "name": "twendezetu-platform",
  "version": "1.0.0",
  "description": "Twendezetu \u2014 events, needs, providers and community money for East Africa and the diaspora. Next.js + Prisma + Supabase Postgres.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:with-migrate": "npm run db:deploy && npm run build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test 'tests/unit/*.test.mjs'",
    "test:integration": "node --test --test-concurrency=1 'tests/integration/*.test.mjs'",
    "db:deploy": "node scripts/prisma-migrate-deploy.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "next": "15.5.20",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "17.4.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "eslint": "9.15.0",
    "eslint-config-next": "15.5.20",
    "prisma": "5.22.0"
  }
}
