# Twendezetu environment. Copy to .env (gitignored) and fill in what you use.
# Every variable is read and checked in src/server/config.js; a missing
# required value stops the server with a message naming it.

# ── Required ──────────────────────────────────────────────────────────────
# Supabase Postgres. DATABASE_URL is the transaction pooler (port 6543) for
# the app; DIRECT_URL is the session pooler (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-REGION.pooler.supabase.com:5432/postgres"

# At least 32 characters. Keys session tokens, signed QR tickets and the
# private links sent to guests. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Required in production: 32 random bytes, base64. Encrypts national ID and
# payout account numbers. Never change it once data is stored.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""

# The public address, used in emails, share links and invite links. On Vercel
# the production domain is picked up automatically when this is unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Card payments (Stripe) ────────────────────────────────────────────────
# Without a secret key, development runs in test mode: payments succeed
# instantly and no money moves. Production refuses that unless
# ALLOW_MOCK_PAYMENTS=true is set on purpose for a demo.
# Webhook endpoint: https://YOUR_DOMAIN/api/payments/stripe/webhook
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
ALLOW_MOCK_PAYMENTS=""

# ── Email (Resend) ────────────────────────────────────────────────────────
# Without a key, emails are written to the server log instead of sent.
RESEND_API_KEY=""
EMAIL_FROM="Twendezetu <hello@your-domain.com>"

# ── Text messages (Africa's Talking) ──────────────────────────────────────
# Phone verification and two-step codes. Without these, development writes
# codes to the server log; production refuses to send codes at all.
AFRICASTALKING_API_KEY=""
AFRICASTALKING_USERNAME=""
AFRICASTALKING_SENDER_ID=""

# ── File storage (Supabase Storage) ───────────────────────────────────────
# Photos go to the public bucket; ID documents, message attachments and
# dispute evidence to the private one. Every file is served through
# /api/files, and private ones only after a permission check.
# Without these, development stores files in the database;
# ALLOW_DATABASE_FILE_STORAGE=true allows that in production too.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_PUBLIC_BUCKET="public-media"
STORAGE_PRIVATE_BUCKET="private-documents"
ALLOW_DATABASE_FILE_STORAGE=""

# ── Rate limiting (Upstash Redis) ─────────────────────────────────────────
# Optional. Without it, limits are kept in Postgres, which is fine for one
# region; Redis is faster at high traffic.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Scheduled jobs ────────────────────────────────────────────────────────
# /api/cron/tick only runs with "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends it automatically.
CRON_SECRET=""

# Exchange rates, refreshed daily. Any endpoint returning { rates: { KES, ... } }
# per US dollar works.
FX_RATES_URL="https://open.er-api.com/v6/latest/USD"
